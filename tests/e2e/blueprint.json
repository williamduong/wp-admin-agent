{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "landingPage": "/wp-admin/",
  "login": true,
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_ENVIRONMENT_TYPE": "local"
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "william-research-admin-agent/wp-admin-agent.php"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; wp_mkdir_p(WPMU_PLUGIN_DIR); copy('/wordpress/wp-content/plugins/william-research-admin-agent/tests/e2e/fixtures/wradmin-e2e-helper.php', WPMU_PLUGIN_DIR . '/wradmin-e2e-helper.php'); update_option('wradmin_provider', 'fake'); update_option('wradmin_model', 'runtime-v1'); update_option('wradmin_data_retention_days', 30);"
    }
  ]
}
